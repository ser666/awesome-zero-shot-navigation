# ══════════════════════════════════════════════════════════════════════════
#  密钥模板 —— 复制为 config/secrets.env 并填入真实值
# ══════════════════════════════════════════════════════════════════════════
#
#    cp config/secrets.env.example config/secrets.env
#    chmod 600 config/secrets.env
#
#  ⚠️ 规则：
#    1. config/secrets.env **已被 .gitignore 排除** —— 永远不要 force add
#    2. 本 .example 文件里**只能有占位符**，绝不能有真实值
#    3. 生产环境优先用真正的环境变量注入（CI Secrets / systemd EnvironmentFile），
#       本文件只是"本机开发时少打几行 export"的便利
#
#  三家运行环境怎么配：
#    本机   → 本文件（config/secrets.env）
#    CI     → GitHub Secrets（workflow 的 env: 块注入）
#    服务器 → systemd EnvironmentFile= 或 shell 里 export
# ══════════════════════════════════════════════════════════════════════════


# ── Zotero 推送 ───────────────────────────────────────────────────────
#
#  ⭐⭐ 如果你用**本地后端**（推荐，也是默认的 auto 模式首选）——
#      **这两个变量都不需要！**
#
#      本地后端（backend = "local"，或 auto 且 Zotero 在运行）走 Zotero
#      桌面端的本地 API（127.0.0.1:23119）：不用账号、不用网站 Key、
#      不用插件、完全离线。首次写入时 Zotero 会弹一个确认框，
#      选 **Always Allow** 即可（key 自动存到 data/zotero_local_keys.json）。
#
#      只需一次性做两件事：
#        ① 装 Zotero 10+（写入需要 10+；7–9 的本地 API 只读）
#        ② Zotero → 设置 → 高级 → 勾选
#           "Allow other applications on this computer to communicate with Zotero"
#
#      然后直接跑：make zotero-push
#
#  ─────────────────────────────────────────────────────────────────────
#  只有当 backend = "web"（要用 Zotero 云端）时，才需要下面两个值：
#    1) 打开 https://www.zotero.org/settings/keys/new
#    2) 勾选 "Allow library access" + "Allow write access"
#    3) 保存后把 API Key 填到下面
#    4) library_id = 你的**数字** userID（同一页顶部 "Your userID for use in
#       API calls is 1234567" 那串数字），不是用户名
#  ⚠️ 注意：web 后端意味着数据会经过 Zotero 的服务器。
#ZOTERO_API_KEY=REPLACE_WITH_YOUR_ZOTERO_API_KEY
#ZOTERO_LIBRARY_ID=REPLACE_WITH_YOUR_NUMERIC_USER_ID


# ── 可选：需要密钥的论文源（config/sources.toml 里 enabled=true 时才用） ─
# SEMANTIC_SCHOLAR_API_KEY=REPLACE_ME
# OPENALEX_EMAIL=you@example.com          # 加入 polite pool，非必需


# ── 可选：MCP HTTP 传输的访问令牌 ──────────────────────────────────────
#  仅在 mcp.transport = "http" 且对外暴露时需要。
#  生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# ZENAV_MCP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
